<?xml version="1.0" encoding="UTF-8"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="connect-src">
            <values>
                <value id="payfabric_com" type="host">*.payfabric.com</value>
                <value id="paypal_com" type="host">*.paypal.com</value>
                <value id="paypal_objects" type="host">*.paypalobjects.com</value>
                <value id="venmo_com" type="host">*.venmo.com</value>
                <value id="apple_pay_cdn" type="host">applepay.cdn-apple.com</value>
                <value id="google_pay" type="host">pay.google.com</value>
            </values>
        </policy>
        <policy id="script-src">
            <values>
                <value id="payfabric_com" type="host">*.payfabric.com</value>
                <value id="paypal_com" type="host">*.paypal.com</value>
                <value id="paypal_objects" type="host">*.paypalobjects.com</value>
                <value id="venmo_com" type="host">*.venmo.com</value>
                <value id="apple_pay_cdn" type="host">applepay.cdn-apple.com</value>
                <value id="google_pay" type="host">pay.google.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="payfabric_com" type="host">*.payfabric.com</value>
                <value id="paypal_com" type="host">*.paypal.com</value>
                <value id="paypal_objects" type="host">*.paypalobjects.com</value>
                <value id="venmo_com" type="host">*.venmo.com</value>
                <value id="google_pay" type="host">pay.google.com</value>
                <value id="data" type="host">data:</value>

            </values>
        </policy>
        <policy id="form-action">
            <values>
                <value id="payfabric_com" type="host">*.payfabric.com</value>
                <value id="paypal_com" type="host">*.paypal.com</value>
                <value id="venmo_com" type="host">*.venmo.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="payfabric_com" type="host">*.payfabric.com</value>
                <value id="paypal_com" type="host">*.paypal.com</value>
                <value id="paypal_objects" type="host">*.paypalobjects.com</value>
                <value id="venmo_com" type="host">*.venmo.com</value>
                <value id="apple_pay_cdn" type="host">applepay.cdn-apple.com</value>
                <value id="google_pay" type="host">pay.google.com</value>
            </values>
        </policy>
        <policy id="child-src">
            <values>
                <value id="paypal_com" type="host">*.paypal.com</value>
                <value id="paypal_objects" type="host">*.paypalobjects.com</value>
                <value id="venmo_com" type="host">*.venmo.com</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="paypal_com" type="host">*.paypal.com</value>
                <value id="paypal_objects" type="host">*.paypalobjects.com</value>
                <value id="venmo_com" type="host">*.venmo.com</value>
            </values>
        </policy>
        <policy id="font-src">
            <values>
                <value id="paypal_objects" type="host">*.paypalobjects.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
